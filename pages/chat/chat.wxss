/* pages/chat/chat.wxss */

/* ---------- 顶部栏 ---------- */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  background: var(--surface);
  border-bottom: 2rpx solid var(--border);
  flex-shrink: 0;
}

.topbar-left {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.menu-icon {
  font-size: 34rpx;
  color: var(--text-2);
  margin-right: 20rpx;
}

.topbar-left .title {
  font-size: 30rpx;
  font-weight: 550;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mode-chip {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 23rpx;
  border-radius: 100rpx;
}

/* ---------- 消息区 ---------- */
.messages {
  flex: 1;
  height: 0;              /* 配合 flex:1，让 scroll-view 正确计算高度 */
  padding: 28rpx 28rpx 0;
}

.bottom-pad {
  height: 28rpx;
}

.row {
  display: flex;
  margin-bottom: 24rpx;
}

.row.user {
  justify-content: flex-end;
}

.row.assistant,
.row.error {
  justify-content: flex-start;
}

.row.error {
  justify-content: center;
}

.bubble {
  max-width: 76%;
  padding: 20rpx 26rpx;
  font-size: 29rpx;
  line-height: 1.65;
  word-break: break-word;
  white-space: pre-wrap;
  border-radius: var(--radius);
}

.row.user .bubble {
  background: var(--primary);
  color: #fff;
  border-bottom-right-radius: 6rpx;
}

.row.assistant .bubble {
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

.row.error .bubble {
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  color: var(--danger);
  font-size: 25rpx;
  max-width: 86%;
  text-align: center;
}

.bubble.loading {
  color: var(--text-3);
  font-size: 25rpx;
}

/* ---------- 附件条 ---------- */
.file-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx 0;
  flex-shrink: 0;
}

.file-chip {
  font-size: 23rpx;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-sm);
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.scope-picker {
  margin-left: 16rpx;
  font-size: 23rpx;
  color: var(--text-2);
  padding: 8rpx 16rpx;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
}

.file-cancel {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-3);
  padding: 8rpx 12rpx;
}

/* ---------- 输入区 ---------- */
.input-area {
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  flex-shrink: 0;
}

.input-box {
  display: flex;
  align-items: flex-end;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 12rpx 14rpx 12rpx 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.attach-btn {
  font-size: 40rpx;
  color: var(--text-3);
  line-height: 1;
  padding: 0 14rpx 6rpx 0;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.6;
  color: var(--text);
  max-height: 220rpx;
  padding: 8rpx 0;
}

.ph {
  color: var(--text-3);
}

.send-btn {
  flex-shrink: 0;
  padding: 14rpx 30rpx;
  background: var(--primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 550;
  border-radius: var(--radius-sm);
  margin-left: 14rpx;
}

.send-btn.disabled {
  background: var(--surface-3);
  color: var(--text-3);
}

/* ---------- 抽屉 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s;
  z-index: 100;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

.drawer {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 76%;
  max-width: 600rpx;
  background: var(--surface);
  transform: translateX(-100%);
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 101;
  display: flex;
  flex-direction: column;
  box-shadow: 4rpx 0 24rpx rgba(0, 0, 0, 0.08);
}

.drawer.open {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(40rpx + env(safe-area-inset-top)) 32rpx 24rpx;
  border-bottom: 2rpx solid var(--border);
}

.drawer-user {
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.drawer-close {
  font-size: 30rpx;
  color: var(--text-3);
  padding: 0 10rpx;
  flex-shrink: 0;
}

.new-chat-btn {
  margin: 24rpx 32rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 550;
  border-radius: var(--radius);
  flex-shrink: 0;
}

.drawer-list {
  flex: 1;
  height: 0;
  padding: 0 20rpx;
}

.drawer-empty {
  padding: 40rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.7;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 22rpx 18rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 6rpx;
}

.session-item.active {
  background: var(--primary-soft);
}

.session-item.active .session-title {
  color: var(--primary);
  font-weight: 550;
}

.session-title {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.session-menu {
  flex-shrink: 0;
  padding: 0 12rpx;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-3);
}

.drawer-footer {
  padding: 26rpx 32rpx calc(26rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--border);
  font-size: 27rpx;
  color: var(--danger);
  text-align: center;
  flex-shrink: 0;
}
