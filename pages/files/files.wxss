/* pages/files/files.wxss */

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: var(--surface);
  border-bottom: 2rpx solid var(--border);
  flex-shrink: 0;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
}

.header-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.upload-btn {
  padding: 16rpx 28rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 550;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.upload-btn.disabled {
  background: var(--surface-3);
  color: var(--text-3);
}

.list {
  flex: 1;
  height: 0;
  padding: 24rpx 28rpx 0;
}

.bottom-pad {
  height: 24rpx;
}

.empty-btn {
  margin-top: 44rpx;
  padding: 0 48rpx;
  height: 76rpx;
  font-size: 27rpx;
}

.file-item {
  display: flex;
  align-items: flex-start;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

.file-icon {
  font-size: 30rpx;
  color: var(--primary);
  margin-right: 20rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.file-main {
  flex: 1;
  overflow: hidden;
}

.file-name {
  font-size: 28rpx;
  font-weight: 500;
  word-break: break-all;
  line-height: 1.5;
}

.file-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-2);
}

.file-meta .dot {
  margin: 0 10rpx;
  color: var(--text-3);
}

.file-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.delete-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--text-3);
  padding: 4rpx 10rpx;
}

.footer-hint {
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  flex-shrink: 0;
}
